# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts



# static export output
/out/


# The evidence directory stays on disk and off this public remote. It quotes
# and summarises unpublished reports — including their weaknesses — and that
# level of detail is Amin's to share, not anyone's who clones the repo. Only
# the README explaining the convention is tracked.
/docs/*
!/docs/README.md
